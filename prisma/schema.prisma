generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A user profile. `id` mirrors the Supabase auth user id (uuid) in production,
/// or a generated id when using the built-in local auth provider.
model Profile {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  avatarUrl    String?
  /// Only set when using the built-in local auth provider (scrypt hash).
  /// Never set when authentication is delegated to Supabase.
  passwordHash String?
  cvs          CV[]
  coverLetters      CoverLetter[]
  applications      Application[]
  applicationEmails ApplicationEmail[]
  exportEvents ExportEvent[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// Lightweight event log — foundation for later download analytics / limits.
model ExportEvent {
  id        String   @id @default(cuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvId      String?
  cv        CV?      @relation(fields: [cvId], references: [id], onDelete: SetNull)
  template  String   @default("classic")
  /// e.g. "PDF_DOWNLOAD"
  type      String   @default("PDF_DOWNLOAD")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([cvId])
}

model CV {
  id             String          @id @default(cuid())
  userId         String
  user           Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String          @default("My CV")
  template       String          @default("classic")
  /// Contact block: fullName, title, email, phone, location, linkedin, portfolio
  personalInfo   Json?
  summary        String?
  experiences    Experience[]
  educations     Education[]
  skills         Skill[]
  projects       Project[]
  certifications Certification[]
  languages      Language[]
  exportEvents   ExportEvent[]
  coverLetters   CoverLetter[]
  applications   Application[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
}

model CoverLetter {
  id              String        @id @default(cuid())
  userId          String
  user            Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The CV this letter draws its applicant details from (kept if the CV is deleted).
  cvId            String?
  cv              CV?           @relation(fields: [cvId], references: [id], onDelete: SetNull)
  title           String        @default("Untitled cover letter")
  companyName     String        @default("")
  jobTitle        String        @default("")
  hiringManager   String        @default("")
  companyLocation String        @default("")
  jobDescription  String        @default("")
  /// Structured letter body (greeting, opening, body, closing, signature, contact snapshot).
  content         Json?
  template        String        @default("classic")
  applications    Application[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([cvId])
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  user            Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvId            String?
  cv              CV?               @relation(fields: [cvId], references: [id], onDelete: SetNull)
  coverLetterId   String?
  coverLetter     CoverLetter?      @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)
  email           ApplicationEmail?
  companyName     String            @default("")
  jobTitle        String            @default("")
  jobDescription  String            @default("")
  companyWebsite  String            @default("")
  jobLocation     String            @default("")
  applicationDate String            @default("")
  /// One of: Saved, Preparing, Applied, Interview, Offer, Rejected
  status          String            @default("Saved")
  salaryRange     String            @default("")
  recruiterName   String            @default("")
  recruiterEmail  String            @default("")
  jobUrl          String            @default("")
  notes           String            @default("")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([status])
}

model ApplicationEmail {
  id            String       @id @default(cuid())
  userId        String
  user          Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Optional link to an application (unique — one email per application).
  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subject       String       @default("")
  content       String       @default("")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
}

model Experience {
  id          String  @id @default(cuid())
  cvId        String
  cv          CV      @relation(fields: [cvId], references: [id], onDelete: Cascade)
  company     String  @default("")
  position    String  @default("")
  location    String  @default("")
  startDate   String  @default("")
  endDate     String  @default("")
  current     Boolean @default(false)
  description String  @default("")
  order       Int     @default(0)

  @@index([cvId])
}

model Education {
  id          String @id @default(cuid())
  cvId        String
  cv          CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)
  institution String @default("")
  degree      String @default("")
  field       String @default("")
  startDate   String @default("")
  endDate     String @default("")
  description String @default("")
  order       Int    @default(0)

  @@index([cvId])
}

model Skill {
  id    String @id @default(cuid())
  cvId  String
  cv    CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)
  name  String @default("")
  level String @default("Intermediate")
  order Int    @default(0)

  @@index([cvId])
}

model Project {
  id           String   @id @default(cuid())
  cvId         String
  cv           CV       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  name         String   @default("")
  description  String   @default("")
  technologies String[] @default([])
  url          String   @default("")
  order        Int      @default(0)

  @@index([cvId])
}

model Certification {
  id     String @id @default(cuid())
  cvId   String
  cv     CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)
  name   String @default("")
  issuer String @default("")
  date   String @default("")
  url    String @default("")
  order  Int    @default(0)

  @@index([cvId])
}

model Language {
  id    String @id @default(cuid())
  cvId  String
  cv    CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)
  name  String @default("")
  level String @default("Conversational")
  order Int    @default(0)

  @@index([cvId])
}
