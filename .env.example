# ─────────────────────────────────────────────────────────────
# Database (required) — Postgres connection string used by Prisma.
# Local Postgres example:
#   postgresql://postgres:postgres@127.0.0.1:5432/cvforge?schema=public
# Supabase example (Project Settings → Database → Connection string):
#   postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/cvforge?schema=public"

# ─────────────────────────────────────────────────────────────
# Authentication
#
# CVForge has two interchangeable auth backends:
#
#  1. LOCAL (zero-config): leave the Supabase vars below BLANK. The app uses
#     built-in email/password auth (scrypt-hashed) against your Postgres DB
#     with a signed, HTTP-only session cookie. Great for local development.
#     Set a strong SESSION_SECRET.
#
#  2. SUPABASE (production): set both NEXT_PUBLIC_SUPABASE_* vars. The app then
#     delegates auth to Supabase (email/password + Google OAuth). Enable the
#     Google provider in Supabase Auth and add this redirect URL:
#         https://YOUR_DOMAIN/auth/callback
#
# Never expose the Supabase service-role key in client code — it is NOT used
# by this app. Only the public anon key is used client-side.
SESSION_SECRET="change-me-to-a-long-random-string"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ─────────────────────────────────────────────────────────────
# Public app URL — used to build absolute links (e.g. email verification).
# Optional: the server also derives this from the incoming request host.
APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Google Sign-In ("Continue with Google") for the built-in LOCAL auth provider.
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# and add your app origin to "Authorized JavaScript origins". No secret is needed
# on the client — the backend verifies the Google ID token against Google's
# public keys (free, no paid API). In SUPABASE mode, configure Google in Supabase
# instead and leave these blank.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# Optional: defaults to NEXT_PUBLIC_GOOGLE_CLIENT_ID if unset.
GOOGLE_CLIENT_ID=""

# ─────────────────────────────────────────────────────────────
# Email delivery (email verification) for the built-in LOCAL auth provider.
#
# Leave ALL of these blank for zero-config local development: verification
# emails (with the confirmation link) are written to the SERVER CONSOLE, so the
# whole signup → verify → login flow works with no external service.
#
# To send real email, set SMTP settings below and install the optional
# `nodemailer` package (`npm i nodemailer`). Any free SMTP works (e.g. a Gmail
# app password, Brevo/SendinBlue free tier, etc.). NEVER commit real credentials.
# In SUPABASE mode, Supabase sends the verification email for free — leave blank.
SMTP_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CVForge <no-reply@cvforge.local>"

# ─────────────────────────────────────────────────────────────
# Admin access
#
# Comma-separated list of emails that are promoted to the ADMIN role on login
# (the DB `role` column is the source of truth; admins can also grant the role
# from the admin dashboard). These accounts can access /admin.
ADMIN_EMAILS=""

# ─────────────────────────────────────────────────────────────
# Payments (subscriptions)
#
# Leave these BLANK to use the built-in SANDBOX payment provider — the full
# payment → verify → activate pipeline works locally without any external
# service (a sandbox checkout page simulates the provider). The server always
# verifies the transaction before granting Pro.
#
# To use a real provider (e.g. a Cameroon mobile-money gateway), set:
#   PAYMENT_PROVIDER   — the provider's name/adapter key (e.g. "campay", "fapshi")
#   PAYMENT_SECRET_KEY — the provider's SECRET key (server-side only, never public)
#   PAYMENT_WEBHOOK_SECRET — shared secret used to authenticate incoming webhooks
#
# NEVER expose the secret/webhook keys to the browser. NEVER commit real keys.
PAYMENT_PROVIDER=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
