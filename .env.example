# ─────────────────────────────────────────────────────────────
# Database (required) — Postgres connection string used by Prisma.
# Local Postgres example:
#   postgresql://postgres:postgres@127.0.0.1:5432/cvforge?schema=public
# Supabase example (Project Settings → Database → Connection string):
#   postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/cvforge?schema=public"

# ─────────────────────────────────────────────────────────────
# Authentication
#
# CVForge has two interchangeable auth backends:
#
#  1. LOCAL (zero-config): leave the Supabase vars below BLANK. The app uses
#     built-in email/password auth (scrypt-hashed) against your Postgres DB
#     with a signed, HTTP-only session cookie. Great for local development.
#     Set a strong SESSION_SECRET.
#
#  2. SUPABASE (production): set both NEXT_PUBLIC_SUPABASE_* vars. The app then
#     delegates auth to Supabase (email/password + Google OAuth). Enable the
#     Google provider in Supabase Auth and add this redirect URL:
#         https://YOUR_DOMAIN/auth/callback
#
# Never expose the Supabase service-role key in client code — it is NOT used
# by this app. Only the public anon key is used client-side.
SESSION_SECRET="change-me-to-a-long-random-string"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
